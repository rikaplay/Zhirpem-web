# Скопируйте значения из web/.env.local в настройки проекта Vercel (Settings -> Environment Variables).
# Сам файл .env.local в репозиторий не попадает (он в .gitignore).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Неподписанный пресет Cloudinary для загрузки видео, звуков и фото (тот же, что в приложении)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ProfilePIC
# Необязательно: адрес Realtime Database, чтобы на карточке профиля работал статус «в сети»
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
